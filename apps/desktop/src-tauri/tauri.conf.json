{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignalFusion LK",
  "version": "1.4.0",
  "identifier": "lk.signalfusion.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SignalFusion LK - Desktop Network Intelligence",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.signalfusion.lk/desktop/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IHNpZ25hdHVyZSBmcm9tIHNpZ25hbGZ1c2lvbiBzZWNyZXQga2V5"
    }
  }
}
